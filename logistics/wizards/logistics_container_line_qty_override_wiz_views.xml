<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_container_line_qty_override_wiz_form" model="ir.ui.view">
        <field name="name">logistics.container.line.qty.override.wiz.form</field>
        <field name="model">logistics.container.line.qty.override.wiz</field>
        <field name="arch" type="xml">
            <form string="Quantity Over Agreement">
                <group>
                    <field name="container_line_id" invisible="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="requisition_id" readonly="1"/>
                    <field name="uom_name" invisible="1"/>
                    <field name="current_qty" readonly="1"/>
                    <field name="remaining_qty" readonly="1"/>
                    <field name="excess_qty" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    This line was entered at
                    <field name="current_qty" readonly="1" class="oe_inline"/>
                    <field name="uom_name" readonly="1" class="oe_inline"/>, exceeding what is
                    left on the agreement by
                    <field name="excess_qty" readonly="1" class="oe_inline"/>
                    <field name="uom_name" readonly="1" class="oe_inline"/>.
                    This was kept and logged in the chatter of both the container line and
                    the agreement.
                </div>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
