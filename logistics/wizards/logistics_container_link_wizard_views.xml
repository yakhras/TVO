<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_container_link_wizard_form" model="ir.ui.view">
        <field name="name">logistics.container.link.wizard.form</field>
        <field name="model">logistics.container.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Existing Containers">
                <group>
                    <field name="bill_lading_id" readonly="1"/>
                    <field name="container_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Link" name="action_link" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
