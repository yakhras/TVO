<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="logistics.LogisticsDashboard">
    <div class="o_logistics_dashboard p-4">
        <t t-if="!state.loaded">
            <div class="text-center p-5 text-muted">Loading...</div>
        </t>
        <t t-else="">

            <!-- Chart grid, one row from lg: Purchase Agreements pie (3) | Bills of Lading
                 stacked bar (3) | Containers columns (6); all charts share one height -->
            <div class="row g-3 mb-4">

                <!-- Purchase Agreements by status (pie chart) -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card p-3 h-100">
                        <!-- Title and total on one line; click opens all agreements -->
                        <div class="o_logistics_chart_head cursor-pointer"
                             t-on-click="() => this.openDeals(false)">
                            <h5 class="mb-0">Purchase Agreements</h5>
                            <span class="fs-4 fw-bold" t-esc="dealsTotal"/>
                        </div>
                        <div class="o_logistics_pie">
                            <canvas t-ref="dealsChart"/>
                        </div>
                    </div>
                </div>

                <!-- Bills of Lading by docs stage (single stacked bar, top to bottom) -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card p-3 h-100">
                        <div class="o_logistics_chart_head cursor-pointer"
                             t-on-click="() => this.openBillLadings()">
                            <h5 class="mb-0">Bills of Lading</h5>
                            <span class="fs-4 fw-bold" t-esc="blTotal"/>
                        </div>
                        <div class="o_logistics_stack">
                            <div t-foreach="blSegments" t-as="seg" t-key="seg.key"
                                 t-attf-class="o_logistics_block text-bg-{{ seg.color }}"
                                 t-att-style="'flex-grow: ' + seg.share"
                                 t-att-title="seg.label + ': ' + seg.count + ' (' + seg.percent + '%)'"
                                 t-on-click="() => this.openBillLadings(seg.draft, seg.original)">
                                <div class="small" t-esc="seg.label"/>
                                <div class="fs-5 fw-bold" t-esc="seg.count"/>
                            </div>
                            <div t-if="!blSegments.length" class="o_logistics_block o_logistics_block_empty text-muted">
                                No bills of lading
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Containers: one column per parent state, at least as wide as its longest label;
                     child state tiles stacked inside, heights by count -->
                <div class="col-12 col-lg-6">
                    <div class="card p-3 h-100">
                        <div class="o_logistics_chart_head cursor-pointer"
                             t-on-click="() => this.openContainers(false)">
                            <h5 class="mb-0">Containers</h5>
                            <span class="fs-4 fw-bold" t-esc="containersTotal"/>
                        </div>
                        <div class="o_logistics_columns">
                            <div t-foreach="containerColumns" t-as="parent" t-key="parent.state"
                                 class="o_logistics_column">
                                <div t-attf-class="o_logistics_column_head text-bg-{{ parent.color }} {{ parent.children.length ? '' : 'flex-grow-1' }}"
                                     t-att-title="parent.title"
                                     t-on-click="() => this.openContainers(parent.state)">
                                    <t t-esc="parent.label"/> <b t-esc="parent.count"/>
                                </div>
                                <div t-foreach="parent.children" t-as="child" t-key="child.id"
                                     t-attf-class="o_logistics_column_tile bg-{{ parent.color }}-subtle text-{{ parent.color }}-emphasis"
                                     t-att-style="'flex-grow: ' + child.count"
                                     t-att-title="child.title"
                                     t-on-click="() => this.openContainersByChildState(child.id, child.name)">
                                    <t t-esc="child.name"/> <b t-esc="child.count"/>
                                </div>
                            </div>
                            <div t-if="!containerColumns.length" class="o_logistics_block o_logistics_block_empty text-muted">
                                No containers
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Upcoming Arrivals -->
            <h5 class="mb-3">Upcoming Arrivals</h5>
            <div class="o_logistics_arrivals_table_wrapper">
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Purchase Agreement</th>
                            <th>Supplier</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Sku price</th>
                            <th>Total Weight</th>
                            <th>Subtotal</th>
                            <th>Container</th>
                            <th>BL</th>
                            <th>MT Price</th>
                            <th>Arriving Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.upcomingArrivals" t-as="line" t-key="line.id">
                            <tr class="cursor-pointer" t-on-click="() => this.openContainerLine(line.id)">
                                <td t-esc="line.requisition_id ? line.requisition_id[1] : ''"/>
                                <td t-esc="line.vendor_id ? line.vendor_id[1] : ''"/>
                                <td t-esc="line.product_id ? line.product_id[1] : ''"/>
                                <td t-esc="line.product_qty"/>
                                <td t-esc="this.fmtCurrency(line.sku_price, line.currency_id)"/>
                                <td t-esc="line.total_weight"/>
                                <td t-esc="this.fmtCurrency(line.subtotal, line.currency_id)"/>
                                <td t-esc="line.container_id ? line.container_id[1] : ''"/>
                                <td t-esc="line.bill_lading_id ? line.bill_lading_id[1] : ''"/>
                                <td t-esc="this.fmtCurrency(line.mt_price, line.currency_id)"/>
                                <td t-esc="line.arrival_date"/>
                            </tr>
                        </t>
                        <t t-if="!state.upcomingArrivals.length">
                            <tr>
                                <td colspan="11" class="text-center text-muted py-3">
                                    No upcoming arrivals
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <div class="text-end" t-if="state.upcomingHasMore">
                <a href="#" t-on-click.prevent="showMoreArrivals">Show More</a>
            </div>

        </t>
    </div>
</t>
</templates>
