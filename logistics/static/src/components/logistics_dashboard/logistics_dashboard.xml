<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="logistics.LogisticsDashboard">
    <div class="o_logistics_dashboard p-4">
        <t t-if="!state.loaded">
            <div class="text-center p-5 text-muted">Loading...</div>
        </t>
        <t t-else="">

            <!-- Deals by status -->
            <h5 class="mb-3">Purchase Agreements</h5>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openDeals('draft')">
                        <div class="small text-muted">Draft</div>
                        <div class="fs-1 fw-bold text-secondary" t-esc="state.kpis.deals_draft || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openDeals('confirmed')">
                        <div class="small text-muted">Confirmed</div>
                        <div class="fs-1 fw-bold text-info" t-esc="state.kpis.deals_confirmed || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openDeals('done')">
                        <div class="small text-muted">Closed</div>
                        <div class="fs-1 fw-bold text-success" t-esc="state.kpis.deals_closed || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openDeals('cancel')">
                        <div class="small text-muted">Cancelled</div>
                        <div class="fs-1 fw-bold text-danger" t-esc="state.kpis.deals_cancelled || 0"/>
                    </div>
                </div>
            </div>

            <!-- Containers by status -->
            <h5 class="mb-3">Containers</h5>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3 col-lg">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openContainers('purchase')">
                        <div class="small text-muted">Purchasing</div>
                        <div class="fs-1 fw-bold text-secondary" t-esc="state.kpis.containers_purchase || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openContainers('oversea')">
                        <div class="small text-muted">Oversea</div>
                        <div class="fs-1 fw-bold text-warning" t-esc="state.kpis.containers_oversea || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openContainers('at_port')">
                        <div class="small text-muted">At Port</div>
                        <div class="fs-1 fw-bold text-warning" t-esc="state.kpis.containers_at_port || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openContainers('arrived')">
                        <div class="small text-muted">Arrived</div>
                        <div class="fs-1 fw-bold text-danger" t-esc="state.kpis.containers_arrived || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openContainers('antrepo')">
                        <div class="small text-muted">Antrepo</div>
                        <div class="fs-1 fw-bold text-success" t-esc="state.kpis.containers_antrepo || 0"/>
                    </div>
                </div>
            </div>

            <!-- Bills of Lading by docs status -->
            <h5 class="mb-3">Bills of Lading</h5>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openBillLadings(false, false)">
                        <div class="small text-muted">Docs Pending</div>
                        <div class="fs-1 fw-bold text-secondary" t-esc="state.kpis.bl_docs_pending || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openBillLadings(true, false)">
                        <div class="small text-muted">Draft Received</div>
                        <div class="fs-1 fw-bold text-warning" t-esc="state.kpis.bl_docs_draft || 0"/>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center p-3 h-100 cursor-pointer"
                         t-on-click="() => this.openBillLadings(true, true)">
                        <div class="small text-muted">Original Received</div>
                        <div class="fs-1 fw-bold text-success" t-esc="state.kpis.bl_docs_original || 0"/>
                    </div>
                </div>
            </div>

            <!-- Upcoming Arrivals -->
            <h5 class="mb-3">Upcoming Arrivals</h5>
            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Purchase Agreement</th>
                        <th>Supplier</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Sku price</th>
                        <th>Total Weight</th>
                        <th>Subtotal</th>
                        <th>Container</th>
                        <th>BL</th>
                        <th>MT Price</th>
                        <th>Arriving Date</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="state.upcomingArrivals" t-as="line" t-key="line.id">
                        <tr class="cursor-pointer" t-on-click="() => this.openContainerLine(line.id)">
                            <td t-esc="line.requisition_id ? line.requisition_id[1] : ''"/>
                            <td t-esc="line.vendor_id ? line.vendor_id[1] : ''"/>
                            <td t-esc="line.product_id ? line.product_id[1] : ''"/>
                            <td t-esc="line.product_qty"/>
                            <td t-esc="this.fmtCurrency(line.sku_price, line.currency_id)"/>
                            <td t-esc="line.total_weight"/>
                            <td t-esc="this.fmtCurrency(line.subtotal, line.currency_id)"/>
                            <td t-esc="line.container_id ? line.container_id[1] : ''"/>
                            <td t-esc="line.bill_lading_id ? line.bill_lading_id[1] : ''"/>
                            <td t-esc="this.fmtCurrency(line.mt_price, line.currency_id)"/>
                            <td t-esc="line.arrival_date"/>
                        </tr>
                    </t>
                    <t t-if="!state.upcomingArrivals.length">
                        <tr>
                            <td colspan="11" class="text-center text-muted py-3">
                                No upcoming arrivals
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

        </t>
    </div>
</t>
</templates>
