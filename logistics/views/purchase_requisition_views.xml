<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_requisition_form_inherit_logistics" model="ir.ui.view">
        <field name="name">purchase.requisition.form.inherit.logistics</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">

            <!-- Smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_containers" icon="fa-cubes">
                    <field string="Containers" name="container_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_bill_ladings" icon="fa-ship">
                    <field string="B/Ls" name="bill_lading_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_container_lines" icon="fa-list">
                    <field string="Lines" name="container_line_count" widget="statinfo"/>
                </button>
            </xpath>

            <!-- New fields after vendor_id -->
            <xpath expr="//field[@name='vendor_id']" position="after">
                <field name="pi_date"/>
            </xpath>

            <!-- Description on Picking on agreement product lines -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_description_variants']" position="after">
                <field name="description_picking" readonly="1" optional="show"/>
            </xpath>

            <!-- Container Lines notebook page after Products -->
            <xpath expr="//page[@name='products']" position="after">
                <page string="Container Lines" name="container_lines">
                    <field name="container_ids" mode="list" readonly="1">
                        <list>
                            <field name="container_number"/>
                            <field name="container_type"/>
                            <field name="state"/>
                            <field name="container_line_ids" widget="many2many_tags" string="Lines"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Extend native list view -->
    <record id="view_purchase_requisition_tree_inherit_logistics" model="ir.ui.view">
        <field name="name">purchase.requisition.list.inherit.logistics</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="pi_date" optional="show"/>
                <field name="description_picking" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Extend native search view -->
    <record id="view_purchase_requisition_filter_inherit_logistics" model="ir.ui.view">
        <field name="name">purchase.requisition.search.inherit.logistics</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="description_picking"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter name="group_description_picking" string="Description on Picking"
                            context="{'group_by': 'description_picking'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_logistics_requisition_pivot" model="ir.ui.view">
        <field name="name">purchase.requisition.pivot.logistics</field>
        <field name="model">purchase.requisition</field>
        <field name="arch" type="xml">
            <pivot string="Purchase Agreements">
                <field name="vendor_id" type="row"/>
                <field name="origin_country_id" type="row"/>
                <field name="logistics_state" type="col"/>
                <field name="total_shipped_qty" type="measure"/>
                <field name="remaining_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Agreement lines analysis (product category + quantity/amount measures) -->
    <record id="view_logistics_requisition_line_pivot" model="ir.ui.view">
        <field name="name">purchase.requisition.line.pivot.logistics</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <pivot string="Agreement Analysis" sample="1">
                <field name="categ_id" type="row"/>
                <field name="partner_id" type="col"/>
                <field name="product_qty" string="Qty on Agreement" type="measure"/>
                <field name="price_subtotal" type="measure"/>
                <field name="price_total" type="measure"/>
                <field name="price_unit" invisible="1"/>
                <field name="price_tax" invisible="1"/>
                <field name="weighted_subtotal" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="view_logistics_requisition_line_list" model="ir.ui.view">
        <field name="name">purchase.requisition.line.list.logistics</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <list string="Agreement Lines" create="0" edit="0" delete="0">
                <field name="requisition_id"/>
                <field name="partner_id" optional="show"/>
                <field name="categ_id" optional="show"/>
                <field name="product_id"/>
                <field name="description_picking" optional="show"/>
                <field name="product_qty" string="Qty on Agreement" sum="Total"/>
                <field name="po_qty_ordered" sum="Total"/>
                <field name="po_qty_received" sum="Total" optional="show"/>
                <field name="po_qty_billed" sum="Total" optional="show"/>
                <field name="qty_to_order" sum="Total" optional="show"/>
                <field name="qty_to_receive" sum="Total" optional="show"/>
                <field name="qty_to_bill" sum="Total" optional="show"/>
                <field name="product_uom_id" groups="uom.group_uom" optional="show"/>
                <field name="price_unit" optional="show"/>
                <field name="avg_kg_price" optional="hide"/>
                <field name="total_weight" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price_subtotal" sum="Total"/>
                <field name="price_total" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_requisition_line_search" model="ir.ui.view">
        <field name="name">purchase.requisition.line.search.logistics</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <search string="Agreement Lines">
                <field name="requisition_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="description_picking"/>
                <field name="partner_id"/>
                <filter name="to_order" string="Remaining to Order" domain="[('qty_to_order', '&gt;', 0)]"/>
                <filter name="to_receive" string="Remaining to Receive" domain="[('qty_to_receive', '&gt;', 0)]"/>
                <filter name="to_bill" string="Remaining to Bill" domain="[('qty_to_bill', '&gt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_categ" string="Product Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_requisition" string="Purchase Agreement" context="{'group_by': 'requisition_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_description_picking" string="Description on Picking" context="{'group_by': 'description_picking'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistics_requisition_line_analysis" model="ir.actions.act_window">
        <field name="name">Agreement Analysis</field>
        <field name="res_model">purchase.requisition.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_logistics_requisition_line_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_logistics_requisition_line_list')})]"/>
        <field name="search_view_id" ref="view_logistics_requisition_line_search"/>
    </record>

</odoo>
