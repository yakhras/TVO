<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sales-side read-only views on container lines -->

    <record id="view_sale_container_line_list" model="ir.ui.view">
        <field name="name">logistics.container.line.sale.list</field>
        <field name="model">logistics.container.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="state" widget="badge"
                       decoration-muted="state == 'purchase'"
                       decoration-warning="state in ('oversea', 'at_port')"
                       decoration-danger="state == 'arrived'"
                       decoration-success="state == 'antrepo'"/>
                <field name="arrival_date"/>
                <field name="product_id"/>
                <field name="product_template" optional="show"/>
                <field name="description_picking" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="origin_country_id" optional="show"/>
                <field name="product_qty" sum="Total Qty"/>
                <field name="total_weight" sum="Total Weight"/>
                <field name="container_id"/>
                <field name="port_of_discharge_id" optional="show"/>
                <field name="dest_city_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sale_container_line_pivot" model="ir.ui.view">
        <field name="name">logistics.container.line.sale.pivot</field>
        <field name="model">logistics.container.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <pivot string="Incoming Containers">
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="product_qty" type="measure"/>
                <field name="total_weight" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sale_container_line_search" model="ir.ui.view">
        <field name="name">logistics.container.line.sale.search</field>
        <field name="model">logistics.container.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="product_template"/>
                <field name="description_picking"/>
                <field name="category_id"/>
                <field name="container_id"/>
                <field name="origin_country_id"/>
                <field name="port_of_discharge_id"/>
                <field name="dest_city_id"/>
                <separator/>
                <filter name="state_purchase" string="Purchasing" domain="[('state', '=', 'purchase')]"/>
                <filter name="state_oversea"  string="Oversea"    domain="[('state', '=', 'oversea')]"/>
                <filter name="state_at_port"  string="At Port"    domain="[('state', '=', 'at_port')]"/>
                <filter name="state_arrived"  string="Arrived"    domain="[('state', '=', 'arrived')]"/>
                <filter name="state_antrepo"  string="Antrepo"    domain="[('state', '=', 'antrepo')]"/>
                <separator/>
                <filter name="filter_arrival_date" string="Arriving Date" date="arrival_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_arrival_date" string="Arriving Date" context="{'group_by': 'arrival_date'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_product_template" string="Product Template" context="{'group_by': 'product_template'}"/>
                    <filter name="group_description_picking" string="Description on Picking" context="{'group_by': 'description_picking'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_origin" string="Origin" context="{'group_by': 'origin_country_id'}"/>
                    <filter name="group_container" string="Container" context="{'group_by': 'container_id'}"/>
                    <filter name="group_port_to" string="Port To" context="{'group_by': 'port_of_discharge_id'}"/>
                    <filter name="group_dest_city" string="Destination City" context="{'group_by': 'dest_city_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_container_line" model="ir.actions.act_window">
        <field name="name">Incoming Containers</field>
        <field name="res_model">logistics.container.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_sale_container_line_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_sale_container_line_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_sale_container_line_pivot')})]"/>
    </record>

    <menuitem id="menu_sale_container_line"
              name="Incoming Containers"
              parent="sale.menu_sale_report"
              action="action_sale_container_line"
              groups="sales_team.group_sale_salesman"
              sequence="50"/>

</odoo>
