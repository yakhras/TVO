<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_armongate_config_form" model="ir.ui.view">
        <field name="name">armongate.config.form</field>
        <field name="model">armongate.config</field>
        <field name="arch" type="xml">
            <form string="Armongate API Configuration">
                <header>
                    <button name="action_login"
                            string="Login"
                            type="object"
                            class="btn-primary"
                            icon="fa-sign-in"/>
                    <button name="action_test_user_api"
                            string="Test User API"
                            type="object"
                            class="btn-secondary"
                            icon="fa-plug"
                            invisible="not access_token"/>
                    <button name="action_test_access_control_points"
                            string="Test Access Points"
                            type="object"
                            class="btn-secondary"
                            icon="fa-plug"
                            invisible="not access_token"/>
                    <button name="action_open_restart_wizard"
                            string="Restart Terminal..."
                            type="object"
                            class="btn-secondary"
                            icon="fa-power-off"
                            invisible="not access_token"/>
                    <button name="action_test_first_and_last_access"
                            string="Test First/Last Access"
                            type="object"
                            class="btn-secondary"
                            icon="fa-plug"
                            invisible="not access_token"/>
                    <button name="action_test_first_and_last_access_yaser"
                            string="Test Access Log (Yaser Akhras)"
                            type="object"
                            class="btn-secondary"
                            icon="fa-plug"
                            invisible="not access_token"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="base_url"/>
                            <field name="organization_id"/>
                            <field name="username"/>
                            <field name="password" widget="password"/>
                        </group>
                        <group string="Session">
                            <field name="access_token" widget="password" readonly="1"/>
                            <field name="token_expires_at" readonly="1"/>
                        </group>
                        <group string="Access Log (Yaser Akhras)">
                            <field name="yaser_log_date_from"/>
                            <field name="yaser_log_date_to"/>
                        </group>
                        <group string="Jotform">
                            <field name="jotform_api_key" widget="password"/>
                        </group>
                    </group>
                    <group string="Last Response">
                        <field name="last_response"
                               widget="text"
                               readonly="1"
                               nolabel="1"
                               style="font-family: monospace; white-space: pre-wrap;"/>
                    </group>
                    <group string="Access Log Table (Yaser Akhras)" invisible="not yaser_log_table">
                        <field name="yaser_log_table" widget="html" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_armongate_restart_terminal_wizard_form" model="ir.ui.view">
        <field name="name">armongate.restart_terminal.wizard.form</field>
        <field name="model">armongate.restart_terminal.wizard</field>
        <field name="arch" type="xml">
            <form string="Restart Terminal">
                <p class="alert alert-warning" role="alert">
                    This restarts a live door controller and will briefly take it offline.
                    Only proceed if you are sure of the Device ID.
                </p>
                <group>
                    <field name="config_id" readonly="1"/>
                    <field name="device_id"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Restart"
                            type="object"
                            class="btn-danger"
                            confirm="This will restart a live door controller and briefly take it offline. Continue?"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_armongate_config" model="ir.actions.act_window">
        <field name="name">Armongate API</field>
        <field name="res_model">armongate.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_armongate_root"
              name="Armongate API"
              sequence="90"/>

    <menuitem id="menu_armongate_config"
              name="Configuration"
              parent="menu_armongate_root"
              action="action_armongate_config"
              sequence="10"/>
</odoo>
