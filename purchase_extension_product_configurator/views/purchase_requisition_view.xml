<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_requisition_form_configurator" model="ir.ui.view">
        <field name="name">purchase.requisition.form.configurator</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">

            <!-- LIST: insert product_template_id before product_id -->
            <xpath expr="//field[@name='line_ids']//list//field[@name='product_id']" position="after">
                <field name="product_template_id"
                       string="Product"
                       optional="show"
                       widget="purchase_requisition_line_product_configurator"
                       domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                       context="{'default_purchase_ok': True}"
                       placeholder="Type to find a product..."/>
            </xpath>

            <!-- LIST: hide product_id (now driven by template widget) and add invisible attribute fields -->
            <xpath expr="//field[@name='line_ids']//list//field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="widget">purchase_requisition_line_product_configurator</attribute>
            </xpath>

            <!-- LIST: add invisible attribute fields after product_description_variants -->
            <xpath expr="//field[@name='line_ids']//list//field[@name='product_description_variants']" position="after">
                <field name="is_configurable_product" column_invisible="True"/>
                <field name="product_template_attribute_value_ids" column_invisible="True"/>
                <field name="product_no_variant_attribute_value_ids" column_invisible="True"/>
                <field name="product_custom_attribute_value_ids" column_invisible="True"/>
            </xpath>

            <!-- FORM: insert product_template_id before product_id -->
            <xpath expr="//field[@name='line_ids']//form//field[@name='product_id']" position="before">
                <field name="product_template_id"
                       widget="purchase_requisition_line_product_configurator"
                       domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                       context="{'default_purchase_ok': True}"/>
                <field name="is_configurable_product" invisible="True"/>
                <field name="product_template_attribute_value_ids" invisible="True"/>
                <field name="product_no_variant_attribute_value_ids" invisible="True"/>
            </xpath>

            <!-- FORM: hide product_id -->
            <xpath expr="//field[@name='line_ids']//form//field[@name='product_id']" position="attributes">
                <attribute name="invisible">True</attribute>
                <attribute name="widget">purchase_requisition_line_product_configurator</attribute>
            </xpath>

            <!-- FORM: add custom attribute values after product_qty -->
            <xpath expr="//field[@name='line_ids']//form//field[@name='product_qty']" position="after">
                <field name="product_custom_attribute_value_ids"
                       widget="custom_many2many_tags"
                       invisible="not is_configurable_product"/>
            </xpath>

        </field>
    </record>
</odoo>
